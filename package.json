{
  "name": "devprojects-backend",
  "version": "1.0.0",
  "description": "Backend con Express, Prisma, TypeScript y MySQL.",
  "main": "backend/dist/index.js",
  "scripts": {
    "start": "ts-node backend/src/index.ts",
    "dev": "nodemon --exec ts-node backend/src/index.ts",
    "build": "tsc",
    "prisma:migrate": "prisma migrate dev",
    "prisma:generate": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "latest",
    "bcryptjs": "latest",
    "cors": "latest",
    "dotenv": "latest",
    "express": "latest",
    "jsonwebtoken": "latest",
    "multer": "latest",
    "mysql2": "latest",
    "nodemailer": "latest"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^1.4.11",
    "@types/node": "^20",
    "nodemon": "^3.1.4",
    "prisma": "latest",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  }
}